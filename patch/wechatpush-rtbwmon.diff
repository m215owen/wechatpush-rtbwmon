 # 配置、变量获取、初始化类
@@ -136,7 +144,7 @@
 	fi
 
 	# 配置检查
-	[ ! -f "/usr/sbin/wrtbwmon" ] && log_change "[WARN] $(translate "wrtbwmon not installed, traffic statistics unavailable")"
+	[ ! -x "/usr/libexec/rtbwmon.sh" ] && [ ! -f "/usr/sbin/wrtbwmon" ] && log_change "[WARN] $(translate "wrtbwmon not installed, traffic statistics unavailable")"
 	[ -z "$ip_version" ] && log_change "[ERROR] $(translate "Cannot get iputils-arping version, please confirm if plugin is running properly")"
 	[ -z "$cu_version" ] && log_change "[ERROR] $(translate "Cannot get curl version, please confirm if plugin is running properly")"
 
@@ -957,9 +965,35 @@
 
 # 流量数据
 usage() {
-	[ ! -f "/usr/sbin/wrtbwmon" ] || [ -z "$1" ] && return
+	[ -z "$1" ] && return
 	# 更新
 	if [ $1 == "update" ]; then
+		# 优先使用 rtbwmon（nft 原生计数，适配 fw4/nftables 环境）
+		if [ -x "/usr/libexec/rtbwmon.sh" ]; then
+			local rtb_csv=$(/usr/libexec/rtbwmon.sh update 2>/dev/null)
+			if [ -n "$rtb_csv" ]; then
+				local rtb_now=$(date +%s)
+				local rtb_lan=$(uci -q get network.lan.device 2>/dev/null)
+				[ -z "$rtb_lan" ] && rtb_lan="br-lan"
+				local rtb_rows=$(echo "$rtb_csv" | awk -F, -v lan="$rtb_lan" 'NF >= 7 && $3 == lan')
+				[ -z "$rtb_rows" ] && rtb_rows="$rtb_csv"
+				{
+					echo "mac,ip,iface,in,out,total,first,last"
+					echo "$rtb_rows" | awk -F, -v ts="$rtb_now" '
+						NF >= 7 && $2 != "" && ($5 + $7) > 0 {
+							m = $2; t = ($5 + 0) + ($7 + 0)
+							if (t > best[m]) {
+								best[m] = t
+								line[m] = sprintf("%s,%s,%s,%s,%s,%s,%s,%s", m, $1, $3, $5 + 0, $7 + 0, t, ts, ts)
+							}
+						}
+						END { for (m in line) print line[m] }'
+				} > "${dir}/usage.db.tmp" 2>/dev/null && mv -f "${dir}/usage.db.tmp" "${dir}/usage.db"
+				return
+			fi
+		fi
+		# 兼容原 wrtbwmon（仅当其仍存在时）
+		[ ! -f "/usr/sbin/wrtbwmon" ] && return
 		version_le() { test "$(echo "$@" | tr " " "\n" | sort -n | head -n 1)" == "$1"; }
 		version_ge() { test "$(echo "$@" | tr " " "\n" | sort -r | head -n 1)" == "$1"; }
 		[ -n "$wr_version" ] && (version_ge "${wr_version}" "1.2.0") && wrtbwmon -f ${dir}/usage.db 2>/dev/null && return
